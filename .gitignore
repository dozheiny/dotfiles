# Allowlist: this folder sits next to a lot of private data (.ssh, Projects, ...)
# and the repo is public, so anything not listed here stays out of git.
/*
!/.gitignore
!/.stow-local-ignore
!/README
!/.gitconfig
!/.profile
!/.bashrc
!/.Xresources
!/.xprofile

!/.config/
/.config/*
!/.config/autostart/
!/.config/copyq/
!/.config/dunst/
!/.config/fish/
!/.config/gtk-3.0/
!/.config/gtk-4.0/
!/.config/helix/
!/.config/hypr/
!/.config/i3/
!/.config/kitty/
!/.config/mimeapps.list
!/.config/nvim/
!/.config/picom/
!/.config/polybar/
!/.config/rofi/
!/.config/swappy/
!/.config/swaync/
!/.config/waybar/
!/.config/wlogout/
!/.config/xsettingsd/

!/.local/
/.local/*
!/.local/bin/
/.local/bin/*
!/.local/bin/jdtls

# Secrets and per-machine state, in any allowed folder
*.bak*
.config/fish/fish_variables
.config/fish/conf.d/local.fish
.config/fish/conf.d/gapcode.fish
.config/copyq/*
!.config/copyq/copyq.conf
!.config/copyq/copyq-commands.ini
