/* X11/i3 variant of config.rasi: same theme, sizes ×1.5 (X11 has no compositor scaling) */
@import "config.rasi"

configuration { dpi: 144; }

window       { width: 840px; border: 2px; border-radius: 24px; }
mainbox      { padding: 21px; spacing: 15px; }
inputbar     { padding: 15px 21px; spacing: 15px; border-radius: 15px; }
listview     { spacing: 6px; }
element      { padding: 12px 18px; spacing: 18px; border-radius: 15px; }
element-icon { size: 36px; }
message      { padding: 12px; border-radius: 15px; }
